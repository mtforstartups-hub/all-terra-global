{
  "name": "all-terra-global",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:resend": "cross-env ENABLE_RESEND_TEST_API=true next dev",
    "build": "next build",
    "start": "node server.js",
    "lint": "eslint",
    "plesk:install": "npm install --include=dev --no-audit --no-fund",
    "plesk:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "plesk:dbcheck": "node -e \"require('dotenv/config');const u=process.env.DATABASE_URL;if(!u){console.log('DATABASE_URL is NOT set in this shell');process.exit(1)}console.log('Connecting as: '+u.replace(/:[^:@\\/]*@/,':***@'));require('mysql2/promise').createConnection(u).then(c=>c.query('select 1 as ok')).then(()=>{console.log('DB OK');process.exit(0)}).catch(e=>{console.error('DB FAILED ['+e.code+']: '+e.message);process.exit(1)})\"",
    "plesk:nuke": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "plesk:build": "npm run build",
    "plesk:deploy": "npm run plesk:install && npm run plesk:clean && npm run plesk:build",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.production scripts/migrate.ts",
    "test:e2e": "playwright test",
    "test:e2e:smtp": "cross-env E2E_REAL_EMAIL=true playwright test tests/e2e/signup-full-flow.spec.ts",
    "test:e2e:resend": "cross-env ENABLE_RESEND_TEST_API=true playwright test",
    "make:zip": "node scripts/make-deploy-zip.mjs"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "better-auth": "^1.7.13",
    "copy-webpack-plugin": "^14.0.0",
    "gsap": "^3.14.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.3",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "nodemailer": "^10.1.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-pdf": "^11.0.0",
    "react-phone-number-input": "^3.4.14",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "resend": "^6.10.0",
    "split-type": "^0.3.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "better-sqlite3",
    "better-auth"
  ]
}
