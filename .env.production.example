# Copy to .env.production in the application root ON THE SERVER, then chmod 600.
# Next.js loads this for both `next build` and `next start`.
# Never commit the real file.

DATABASE_URL="mysql://user:password@localhost:3306/database"

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Comma-separated
ADMIN_EMAIL="admin@your-domain.com"

EMAIL_PROVIDER="resend"
EMAIL_USER="no-reply@your-domain.com"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Only when EMAIL_PROVIDER="smtp"
# EMAIL_HOST="smtp.your-host.com"
# EMAIL_PORT="587"
# EMAIL_PASSWORD="smtp-password"
