# Copy to .env.test (git-ignored) and adjust if you change ports.
# This file is only read by the Playwright harness and scripts/e2e-setup.ts.

# --- Database: the dedicated E2E container (docker-compose.e2e.yml, port 3307)
DATABASE_URL="mysql://root:e2e-secret-pw@127.0.0.1:3307/allterraE2E"

# --- App / auth
BETTER_AUTH_SECRET="e2e-only-secret-not-used-in-production-0001"
BETTER_AUTH_URL="http://localhost:3100"
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# --- Email: everything goes to Mailpit, never to the internet
EMAIL_PROVIDER="smtp"
EMAIL_HOST="127.0.0.1"
EMAIL_PORT="1025"
EMAIL_SECURE="false"
EMAIL_USER="no-reply@allterra.test"
EMAIL_PASSWORD="e2e-mailpit"
RESEND_API_KEY="re_e2e_dummy_key_not_used"
ADMIN_EMAIL="admin@allterra.test"

# --- Harness behaviour
# The dev-only interceptor in lib/send-email.ts is bypassed here so the real
# send path runs and Mailpit can assert on it. Nothing can leave your machine
# because EMAIL_HOST is Mailpit.
ALLOW_REAL_EMAILS="true"
INTERCEPT_TEST_EMAILS="false"

# --- Playwright
E2E_PORT="3100"
MAILPIT_URL="http://127.0.0.1:8025"
